    "express-session": "^1.18.2",
    "file-type": "^22.3.0",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
