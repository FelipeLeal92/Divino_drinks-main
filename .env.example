# Copie para .env e preencha os valores reais
# NUNCA commite o arquivo .env real!

# Admin (gere o hash com: node -e "console.log(require('bcrypt').hashSync('sua_senha_forte', 12))")
ADMIN_EMAIL=divinodrinks@gmail.com
ADMIN_PASSWORD_HASH=

# Sessão (OBRIGATÓRIO em produção - gere com: openssl rand -hex 32)
# Mínimo 32 caracteres hexadecimais
SESSION_SECRET=

# E-mail (Nodemailer) - Configure para produção
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Divino Drinks <seu-email@gmail.com>
MAIL_TO=

# Contato público
WHATSAPP_PHONE=5571987933490
INSTAGRAM_URL=https://www.instagram.com/divinodrinksba

# Ambiente
# NODE_ENV=production (em produção)
NODE_ENV=development
PORT=3000

# HTTPS (defina como 'true' apenas se estiver atrás de proxy com TLS)
HTTPS=false

# Armazenamento local (opcional; caminhos absolutos para volume persistente)
# DB_PATH=D:/dados/divino/db.json
# UPLOAD_DIR=D:/dados/divino/uploads
